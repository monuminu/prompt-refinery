# Copy to .env (or run npm run setup). Never commit your real key.
OPENAI_API_KEY=
# API root, including /v1. The app appends /responses.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
# Leave blank to use the provider's default, or set a supported effort.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=120000
PORT=3000
